{
  "name": "moonscore-3d-trial",
  "version": "0.1.6",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lumiscore": "npm run gen:samples && node scripts/sync-deploy-public.mjs && vite build --config vite.lumiscore.config.ts",
    "build:pages": "node scripts/sync-deploy-public.mjs && vite build --config vite.lumiscore.config.ts",
    "gen:samples": "npx esbuild scripts/gen-sample-data.ts --bundle --platform=node --format=esm --outfile=.tmp-gen-samples.mjs --log-level=warning && node .tmp-gen-samples.mjs",
    "postbuild": "node scripts/build-content.mjs && node scripts/build-og.mjs && node scripts/stamp-sitemap.mjs && node scripts/check-links.mjs && node scripts/upload-sourcemaps.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:heavy": "E2E_HEAVY=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/build-icons.mjs",
    "preview:serp": "node scripts/preview-serp.mjs",
    "bench": "VITE_ENABLE_BENCH=1 npx vite build && node scripts/bench.mjs",
    "bench:update": "VITE_ENABLE_BENCH=1 npx vite build && node scripts/bench.mjs --update"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@t3-oss/env-core": "^0.13.11",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/midi": "^4.10.2",
    "@tonejs/midi": "^2.0.28",
    "@vercel/analytics": "^2.0.1",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "fonteditor-core": "^2.6.3",
    "mediabunny": "^1.41.0",
    "meshline": "^3.3.1",
    "opentype.js": "^2.0.0",
    "pixi-filters": "^6.0.1",
    "pixi.js": "^8.4.0",
    "posthog-js": "^1.369.3",
    "smplr": "^1.1.0",
    "solid-js": "^1.9.12",
    "three": "^0.186.1",
    "three.quarks": "^0.17.1",
    "tone": "^14.7.77",
    "verovio": "^6.3.0",
    "vexflow": "^5.0.0",
    "webmscore": "^1.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@posthog/cli": "^0.7.10",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/testing-library": "^0.8.10",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^25.0.1",
    "marked": "^18.0.2",
    "playwright": "^1.59.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.0"
  }
}
