			const mm = m.material as THREE.MeshStandardMaterial;
			mm.color.setHex(color);
			mm.emissive.setHex(color);
			mm.emissiveIntensity = surf.litGlow;
		}
	}
}
/** 预设点亮主题 → 音轨颜色表（音轨面板同步刷新） */
function applyLitTheme(key: string): void {
