;(window as any).__test = {
  get bloom() { return { strength: bloomPass.strength, radius: bloomPass.radius, threshold: bloomPass.threshold }; },
  setBloomStrength(v: number) { bloomPass.strength = v; },
  setBloomRadius(v: number) { bloomPass.radius = v; },
  setBloomThreshold(v: number) { bloomPass.threshold = v; },
  get ballRadius() { return ballRadius; },
  setBallRadius(v: number) { ballRadius = v; for (const bt of ballTracks) for (const b of bt.pool) b.scale.setScalar(v / 0.035); },
  get trailSec() { return (surf.trailPct / 100) * TRAIL_REF_SEC; },
  setTrailSec(v: number) { surf.trailPct = (v / TRAIL_REF_SEC) * 100; },
  get jumpHeight() { return surf.jumpHeight; },
  setJumpHeight(v: number) { surf.jumpHeight = v; },
  trailDebug() {
    const out: {
      ballVis: boolean; n: number; trailVis: boolean; draw: number;
      color: string; parent: string; pos: number[]; last: number[] | null;
    }[] = [];
    for (const bt of ballTracks) {
      for (const b of bt.pool) {
        const hist = b.userData.hist as HistPt[] | undefined;
        const tr = b.userData.trail as TrailObj | undefined;
        if (!hist || !tr) continue;
        out.push({
          ballVis: b.visible, n: hist.length, trailVis: tr.mesh.visible,
          draw: tr.geo.drawRange.count, color: "#" + tr.mat.color.getHexString(),
          parent: b.parent === world ? "world" : b.parent === scene ? "scene" : String(b.parent?.type),
          pos: b.position.toArray().map((v) => +v.toFixed(2)),
          last: hist.length ? hist[hist.length - 1]!.p.toArray().map((v) => +v.toFixed(2)) : null,
        });
      }
    }
    return out.filter((o) => o.ballVis || o.n > 0).slice(0, 6);
  },
};
