/** WebGL 不可用时的兜底界面：顶栏保留，画布留空，给出排查建议 */
function showFatal(detail: string): void {
	const hintEl = document.getElementById("hint");
	if (hintEl) hintEl.hidden = true;
	const emptyEl = document.getElementById("empty");
	if (emptyEl) emptyEl.hidden = true;
	const box = document.createElement("div");
	box.className = "p4-fatal";
	const esc = detail.replace(/[<>&]/g, (c) =>
		c === "<" ? "&lt;" : c === ">" ? "&gt;" : "&amp;",
	);
	box.innerHTML = `
    <div class="box">
      <h2>无法启动 3D 渲染</h2>
      <p>浏览器没能创建 WebGL 上下文，3D 画布保持空白。顶栏与乐谱数据不受影响。</p>
      <ul>
        <li>浏览器设置 → 系统 → 打开「使用图形加速功能（可用时）」，然后重启浏览器</li>
        <li>地址栏打开 <code>chrome://gpu</code>，看 WebGL 是否被禁用</li>
        <li>更新显卡驱动；或关闭其它占用 GPU 的标签页后重试</li>
      </ul>
      <pre>${esc}</pre>
    </div>`;
	document.body.append(box);
	applyI18n(document.body);
}

